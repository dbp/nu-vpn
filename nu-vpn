APP = "nu-vpn"
TITLE = "Northeastern VPN"
SCRIPT = Path(__file__).resolve()
HOME = Path.home()
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / APP
DATA_DIR = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local/share") / APP
CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME") or HOME / ".cache") / APP
CONFIG_FILE = CONFIG_DIR / "config.ini"
TRACE_FILE = CACHE_DIR / "last-login.log"

EXIT_FAILED = 1
EXIT_CANCELED = 2
EXIT_NEEDS_USER = 3      # interaction needed but NetworkManager didn't allow it

LOGIN_TIMEOUT = 110      # NetworkManager gives a secret agent 120 s to answer
STUCK_AFTER = 20         # seconds on an unrecognised page before showing the window
MAX_TRIES = 3            # times to retry one action before showing the window
MAX_PUSHES = 3           # Duo pushes to (re)send before giving up
# Microsoft's pages re-render ~0.7-0.9 s after they appear, swapping in fresh
# elements (an empty username box; buttons whose clicks then go nowhere), so
# on those pages an element must have existed this long before we use it.
# For the Duo code, checking the value is still there is enough.
SETTLE_MS = 1200
# (Once Microsoft remembers you, the first page is the password one.)
SETTLE_STATES = ("username", "password", "picker", "proofs", "continue", "kmsi")


class Abort(Exception):
    def __init__(self, message, code=EXIT_FAILED):
        super().__init__(message)
        self.code = code


def log(msg):
    print(f"{APP}: {msg}", file=sys.stderr, flush=True)


# ---------------------------------------------------------------- config ---

def load_config():
    cp = configparser.ConfigParser()
    cp.read(CONFIG_FILE)
    for section in ("vpn", "login"):
        if not cp.has_section(section):
            cp.add_section(section)
    return cp


def save_config(cp):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    tmp = CONFIG_FILE.with_suffix(".tmp")
    with open(tmp, "w") as f:
        cp.write(f)
    tmp.replace(CONFIG_FILE)


def config_uuids(cfg):
    return cfg.get("vpn", "uuid", fallback="").split()


# --------------------------------------------------------------- keyring ---

def _keyring():
    import gi
    gi.require_version("Secret", "1")
    from gi.repository import Secret
    schema = Secret.Schema.new("edu.northeastern.nu-vpn", Secret.SchemaFlags.NONE,
                               {"username": Secret.SchemaAttributeType.STRING})
    return Secret, schema


def get_password(username):
    Secret, schema = _keyring()
    return Secret.password_lookup_sync(schema, {"username": username}, None)


def store_password(username, password):
    Secret, schema = _keyring()
    ok = Secret.password_store_sync(schema, {"username": username}, Secret.COLLECTION_DEFAULT,
                                    f"{TITLE} password ({username})", password, None)
    if not ok:
        raise Abort("could not save the password in the keyring")


# --------------------------------------------------------------- dialogs ---

def kdialog_argv(kind, text, default=""):
    if kind == "password":
        return ["kdialog", "--title", TITLE, "--password", text]
    return ["kdialog", "--title", TITLE, "--inputbox", text, default]


def ask_sync(kind, text, default=""):
    """Prompt with kdialog when there's a desktop, else on the terminal."""
    if shutil.which("kdialog") and (os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")):
        p = subprocess.run(kdialog_argv(kind, text, default), capture_output=True, text=True)
        if p.returncode != 0:
            raise Abort("cancelled", EXIT_CANCELED)
        return p.stdout.rstrip("\n")
    if sys.stdin.isatty():
        import getpass
        if kind == "password":
            return getpass.getpass(text + " ")
        answer = input(f"{text} [{default}] " if default else f"{text} ")
        return answer.strip() or default
    raise Abort("no way to ask for input (no desktop, no terminal)")


def notify(text, replaces=0, timeout_ms=10000, summary=TITLE, urgent=False):
    """Desktop notification; returns its id (0 if it couldn't be shown).
    Urgent ones stay on screen until closed."""
    try:
        from gi.repository import Gio, GLib
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        hints = {"urgency": GLib.Variant("y", 2)} if urgent else {}
        reply = bus.call_sync(
            "org.freedesktop.Notifications", "/org/freedesktop/Notifications",
            "org.freedesktop.Notifications", "Notify",
            GLib.Variant("(susssasa{sv}i)", (TITLE, replaces, "network-vpn", summary, text, [], hints,
                                            timeout_ms)),
            GLib.VariantType("(u)"), Gio.DBusCallFlags.NONE, 3000, None)
        return reply.unpack()[0]
    except Exception as e:
        log(f"couldn't show a notification: {e}")
        return 0


def close_notification(nid):
    if not nid:
        return
    try:
        from gi.repository import Gio, GLib
        Gio.bus_get_sync(Gio.BusType.SESSION, None).call_sync(
            "org.freedesktop.Notifications", "/org/freedesktop/Notifications",
            "org.freedesktop.Notifications", "CloseNotification", GLib.Variant("(u)", (nid,)),
            None, Gio.DBusCallFlags.NONE, 3000, None)
    except Exception:
        pass


# ------------------------------------------------------ NetworkManager -----

class VpnInfo:
    """What we need from the NetworkManager connection's vpn.data."""

    def __init__(self, data, authgroup=""):
        gw = data.get("gateway", "")
        gw = re.sub(r"^https?://", "", gw)
        host, _, usergroup = gw.partition("/")
        self.host = host
        self.interface = (usergroup.split(":")[0] or "portal") if usergroup else "portal"
        self.protocol = data.get("protocol", "gp")
        self.useragent = data.get("useragent", "") or "PAN GlobalProtect"
        self.platname = data.get("reported_os", "")
        self.authgroup = authgroup
        if not self.host:
            raise Abort("the NetworkManager connection has no gateway set")
        if self.protocol != "gp":
            raise Abort(f"only GlobalProtect is supported (connection uses {self.protocol!r})")


def nm_vpn_data(uuid):
    import dbus
    bus = dbus.SystemBus()
    settings = dbus.Interface(bus.get_object("org.freedesktop.NetworkManager",
                                             "/org/freedesktop/NetworkManager/Settings"),
                              "org.freedesktop.NetworkManager.Settings")
    path = settings.GetConnectionByUuid(uuid)
    conn = dbus.Interface(bus.get_object("org.freedesktop.NetworkManager", path),
                          "org.freedesktop.NetworkManager.Settings.Connection")
    s = conn.GetSettings()
    return {str(k): str(v) for k, v in s.get("vpn", {}).get("data", {}).items()}


# -------------------------------------------------------------- portal -----

def gp_os_name(platname):
    # Same mapping openconnect uses for the clientos field.
    if platname in ("mac-intel", "apple-ios"):
        return "Mac"
    if platname in ("linux", "linux-64"):
        return "Linux"
    return "Windows"


def prelogin(vpn):
    base = "global-protect" if vpn.interface == "portal" else "ssl-vpn"
    query = urllib.parse.urlencode({"tmp": "tmp", "kerberos-support": "yes", "ipv6-support": "yes",
                                    "clientVer": "4100", "clientos": gp_os_name(vpn.platname)})
    req = urllib.request.Request(f"https://{vpn.host}/{base}/prelogin.esp?{query}", data=b"",
                                 headers={"User-Agent": vpn.useragent})
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            root = ET.fromstring(r.read())
    except OSError as e:
        raise Abort(f"can't reach {vpn.host}: {e}")
    status = root.findtext("status")
    if status != "Success":
        raise Abort(f"portal prelogin failed: {root.findtext('msg') or status}")
    method = (root.findtext("saml-auth-method") or "").upper()
    blob = root.findtext("saml-request") or ""
    if not method or not blob:
        raise Abort(f"{vpn.host} did not ask for a SAML sign-in; nothing for {APP} to automate")
    return method, base64.b64decode(blob).decode()


def openconnect_auth(vpn, saml):
    oc = shutil.which("openconnect") or next(
        (p for p in ("/usr/sbin/openconnect", "/sbin/openconnect") if os.path.exists(p)), None)
    if not oc:
        raise Abort("openconnect is not installed")
    if saml.get("prelogin-cookie"):
        cookie_name, cookie = "prelogin-cookie", saml["prelogin-cookie"]
    else:
        cookie_name, cookie = "portal-userauthcookie", saml["portal-userauthcookie"]
    cmd = [oc, "--protocol", vpn.protocol, "--authenticate", "--non-inter", "--passwd-on-stdin",
           "--useragent", vpn.useragent, "--user", saml["saml-username"],
           "--usergroup", f"{vpn.interface}:{cookie_name}"]
    if vpn.platname:
        cmd += ["--os", vpn.platname]
    if vpn.authgroup:
        cmd += ["--authgroup", vpn.authgroup]
    cmd.append(vpn.host)
    try:
        p = subprocess.run(cmd, input=cookie + "\n", capture_output=True, text=True, timeout=60)
    except subprocess.TimeoutExpired:
        raise Abort("openconnect timed out logging in to the portal")
    if p.returncode != 0:
        tail = " / ".join(p.stderr.strip().splitlines()[-3:])
        raise Abort(f"openconnect could not log in with the SAML result: {tail}")
    vals = {}
    for line in p.stdout.splitlines():
        try:
            parts = shlex.split(line)
        except ValueError:
            continue
        if len(parts) == 1 and "=" in parts[0]:
            k, v = parts[0].split("=", 1)
            vals[k] = v
    if not vals.get("COOKIE") or not vals.get("FINGERPRINT"):
        raise Abort("openconnect didn't return a cookie")
    secrets = {"cookie": vals["COOKIE"],
               "gateway": vals.get("CONNECT_URL") or vals["HOST"],
               "gwcert": vals["FINGERPRINT"]}
    if vals.get("RESOLVE"):
        secrets["resolve"] = vals["RESOLVE"]
    return secrets


