# Helpers injected ahead of every script we run in the page. Each script is
# then evaluated as ((NU) => (SCRIPT))(__nuvpn). `var`, because the page keeps
# its globals between our calls and a second `const` would throw.
JS_LIB = r"""
var __nuvpn = (() => {
  const vis = e => {
    if (!e || !e.isConnected) return false;
    if (e.closest('[aria-hidden=true]')) return false;     // e.g. Microsoft's off-screen passwd field
    const r = e.getBoundingClientRect();
    if (r.width <= 0 || r.height <= 0 || r.right <= 0 || r.bottom <= 0) return false;
    const s = getComputedStyle(e);
    return s.visibility !== 'hidden' && s.display !== 'none';
  };
  const all = s => Array.from(document.querySelectorAll(s)).filter(vis);
  const q = s => all(s)[0] || null;
  const text = e => ((e && (e.innerText || e.value || e.getAttribute('aria-label'))) || '').trim();
  const CLICKABLE = 'button, a, [role=button], [role=link], [role=option], li, input[type=submit], input[type=button]';
  // The innermost visible clickable whose text matches: clicking an <li>
  // never reaches a handler on the <a> inside it, the reverse always does.
  const byText = (re, sel = CLICKABLE) => {
    const hits = all(sel).filter(e => re.test(text(e)));
    const inner = hits.filter(e => !hits.some(o => o !== e && e.contains(o)));
    inner.sort((a, b) => text(a).length - text(b).length);
    return inner[0] || null;
  };
  // Set an input's value in a way React/Knockout notice.
  const setValue = (el, v) => {
    el.focus();
    Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set.call(el, v);
    el.dispatchEvent(new Event('input', {bubbles: true}));
    el.dispatchEvent(new Event('change', {bubbles: true}));
  };
  const click = el => { if (!el) return false; el.click(); return true; };
  const MS_SUBMIT = '#idSIButton9, input[type=submit], button[type=submit]';
  const BUTTONS = 'input[type=submit], input[type=button], button, [role=button]';
  const PUSH_SEND = /^(Send (me )?a (Duo )?push|Send (Duo )?push|Send another push|Resend( push)?|Try again)$/i;
  const DUO_CODE = '#passcode-input, input[name="passcode-input"], input[autocomplete="one-time-code"], input[name=passcode]';
  return {vis, all, q, text, byText, setValue, click, MS_SUBMIT, BUTTONS, PUSH_SEND, CLICKABLE, DUO_CODE};
})();
"""

# Works out which sign-in step the page is on. Reads nothing it shouldn't:
# field values are never returned.
JS_CLASSIFY = r"""
(() => {
  const {q, all, text, byText} = NU;
  const host = location.host;
  const out = {host, path: location.pathname, title: document.title};
  const body = document.body ? document.body.innerText : '';
  const err = all('#usernameError, #passwordError, #idTD_Error, #errorText, .alert-error, [role=alert], .verify-error, .error-message')
                .map(text).filter(Boolean)[0];
  if (err) out.error = err.slice(0, 300);
  // How long the element we'd act on has existed. Pages re-render shortly
  // after appearing (Microsoft swaps in a fresh, empty username box), so
  // acting on a brand-new element can be wasted.
  const seen = (state, el) => {
    out.state = state;
    if (el) { if (!el.__nuSeen) el.__nuSeen = Date.now(); out.age = Date.now() - el.__nuSeen; }
  };
  let el;
  if (/(^|\.)(login\.microsoftonline\.com|login\.microsoft\.com|login\.windows\.net)$/.test(host)) {
