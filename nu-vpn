    if not args.keep_password or not get_password(username):
        pw = ask_sync("password", f"Password for {username}:")
        if not pw:
            raise Abort("no password given")
        store_password(username, pw)
    print(f"saved: username in {CONFIG_FILE}, password in the keyring")


