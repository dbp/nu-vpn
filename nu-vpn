    else if (document.querySelector('#KmsiCheckboxField') || /^\s*Stay signed in\?/m.test(body)) seen('kmsi', q('#idSIButton9'));
    // Hand-off to Duo (Entra external authentication method).
    else if (/^\s*Verification Required\s*$/mi.test(body) && (el = byText(/^Continue$/, NU.BUTTONS))) seen('continue', el);
    else if (el = q('input[name=passwd], input[type=password]')) seen('password', el);
    else if (el = q('input[name=loginfmt]')) seen('username', el);
    else if (el = q('#tilesHolder [role=button], #tilesHolder .table, [data-test-id][role=button]')) seen('picker', el);
    else if (el = q('#idDiv_SAOTCS_Proofs [role=button], #idDiv_SAOTCS_Proofs .table, [data-value][role=button]')) seen('proofs', el);
  } else if (/(^|\.)duosecurity\.com$/.test(host)) {
    out.idp = 'duo';
    const METHOD = /^(Duo Push|Duo Mobile passcode|Text message passcode|Phone call|Bypass code|Security key|Touch ID|Windows Hello|Hardware token)/i;
    const methods = [...new Set(all(NU.CLICKABLE).map(e => text(e).split('\n')[0].trim()).filter(t => METHOD.test(t)))];
    if (el = q('#trust-browser-button') || byText(/^Yes, this is my device$/i)) seen('trust', el);
    else if (el = q(NU.DUO_CODE)) seen('passcode', el);
