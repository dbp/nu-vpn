  out.heading = h ? text(h).slice(0, 100) : '';
  out.buttons = all('button, input[type=submit], a, [role=button], [role=link]')
                  .map(e => text(e).replace(/\s+/g, ' ').slice(0, 50)).filter(Boolean).slice(0, 20);
  return JSON.stringify(out);
})()
"""

