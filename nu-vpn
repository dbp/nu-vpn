def do_login(cfg, uuid, interactive=True, timeout=LOGIN_TIMEOUT, probe=False):
    deadline = time.monotonic() + timeout
    username = cfg.get("login", "username", fallback="").strip()
    if not username and not probe:
        raise Abort(f"no username configured; run: {APP} setup")
    vpn = VpnInfo(nm_vpn_data(uuid), cfg.get("vpn", "gateway", fallback="").strip())
    method, saml = prelogin(vpn)
    log(f"portal {vpn.host} wants SAML ({method}); signing in as {username}")
    duo = cfg.get("login", "duo", fallback="push").strip().lower()
    if duo not in ("push", "passcode"):
        raise Abort(f"[login] duo must be push or passcode, not {duo!r}")
    browser = SamlBrowser(vpn, username, interactive, deadline, probe=probe, duo=duo)
    result = browser.run(method, saml)
    if probe:
        return result
    return openconnect_auth(vpn, result)


def cmd_login(args, cfg):
    uuid = args.uuid or (config_uuids(cfg) or [None])[0]
    if not uuid:
        raise Abort(f"no VPN connection configured; run: {APP} setup")
    if os.environ.get("NU_VPN_FAKE_LOGIN"):          # for testing the agent wiring only
        secrets = {"cookie": "fake", "gateway": "https://127.0.0.1:9/", "gwcert": "pin-sha256:fake"}
    else:
        secrets = do_login(cfg, uuid, interactive=not args.no_interaction,
                           timeout=args.timeout, probe=args.probe)
    if args.json:
        json.dump(secrets, sys.stdout)
        sys.stdout.write("\n")
    elif args.probe:
        print(json.dumps(secrets["probe"], indent=2))
    else:
        print(f"signed in; gateway {secrets['gateway']} (cookie not shown)")


def cmd_setup(args, cfg):
    if args.uuid:
        cfg.set("vpn", "uuid", args.uuid)
    if args.gateway is not None:
        cfg.set("vpn", "gateway", args.gateway)
    username = args.username or ask_sync(
