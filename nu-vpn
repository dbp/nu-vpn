class SamlBrowser:
    """Runs the SAML sign-in in a (normally hidden) WebKit view."""

    def __init__(self, vpn, username, interactive, deadline, probe=False, duo="push"):
        import gi
        gi.require_version("Gtk", "4.0")
        gi.require_version("WebKit", "6.0")
        gi.require_version("Soup", "3.0")
        gi.require_version("GLibUnix", "2.0")
        from gi.repository import Gio, GLib, GLibUnix, Gtk, WebKit
        self.Gio, self.GLib, self.GLibUnix, self.Gtk, self.WebKit = Gio, GLib, GLibUnix, Gtk, WebKit

        self.vpn = vpn
        self.username = username
        self.interactive = interactive
        self.deadline = deadline
        self.probe = probe
        self.result = None
        self.error = None
        self.busy = False            # a JS call or a dialog is in flight
        self.shown = False
        self.shown_at = None         # (host, path, state) the window was shown for
        self.last_key = None
        self.last_change = time.monotonic()
        self.acted = {}              # (host, path, state) -> [count, last time]
        self.pw_submitted = False
        self.user_submitted = False
        self.pw_sent_at = 0.0
        self.code_sent_at = None
        self.code_prompts = 0
        self.prompt_proc = None
        self.duo = duo               # "push" (approve on the phone) or "passcode"
        self.push_sends = 0          # pushes we asked Duo to (re)send
        self.push_notice = 0         # id of the "approve the push" notification
        self.push_notice_code = None
        self.push_seen_at = None
        self.no_push = False         # Duo offered no push; use the passcode instead
        self.trace_lines = []

        Gtk.init()
        self.loop = GLib.MainLoop()
        for d in (DATA_DIR / "webkit", CACHE_DIR / "webkit"):
            d.mkdir(parents=True, exist_ok=True)
        os.chmod(DATA_DIR, 0o700)
        # A persistent session, so Microsoft's "stay signed in" and Duo's
        # "remember this device" survive between connections.
        self.session = WebKit.NetworkSession.new(str(DATA_DIR / "webkit"), str(CACHE_DIR / "webkit"))
        self.session.get_cookie_manager().set_persistent_storage(
            str(DATA_DIR / "webkit" / "cookies.sqlite"), WebKit.CookiePersistentStorage.SQLITE)
        self.view = WebKit.WebView(network_session=self.session)
        self.view.connect("load-changed", self.on_load_changed)
        self.view.connect("load-failed", self.on_load_failed)
        self.win = Gtk.Window(title=f"{TITLE} sign-in", default_width=520, default_height=720)
        self.win.set_child(self.view)
        self.win.connect("close-request", self.on_close)

    # -- plumbing --------------------------------------------------------

    def run(self, method, saml):
        self.size_hidden_view()
        if method == "POST":
            self.view.load_html(saml, f"https://{self.vpn.host}/")
        else:
            self.view.load_uri(saml)
        self.GLib.timeout_add(300, self.tick)
        remaining = max(1, int(self.deadline - time.monotonic()))
        self.GLib.timeout_add_seconds(remaining, self.on_timeout)
        for sig in (signal.SIGTERM, signal.SIGINT):     # NetworkManager cancelled, or ^C
            self.GLibUnix.signal_add(self.GLib.PRIORITY_HIGH, sig, self.on_signal)
        self.loop.run()
        self.win.destroy()
        self.write_trace()
        if self.error:
            raise self.error
        return self.result

    def stop(self, result=None, error=None):
        if self.result is None and self.error is None:
            self.result, self.error = result, error
        if self.prompt_proc is not None:               # don't leave a dialog behind
            self.prompt_proc.force_exit()
        close_notification(max(self.push_notice, 0))
        self.push_notice = 0
        self.loop.quit()

    def trace(self, line):
        self.trace_lines.append(f"{time.strftime('%H:%M:%S')} {line}")
        log(line)

    def write_trace(self):
        try:
            CACHE_DIR.mkdir(parents=True, exist_ok=True)
            TRACE_FILE.write_text("\n".join(self.trace_lines) + "\n")
        except OSError:
            pass

    def js(self, script, callback=None):
        def done(view, res):
            try:
                value = view.evaluate_javascript_finish(res)
                out = value.to_string() if value is not None else None
            except Exception as e:  # page navigated away mid-call, etc.
                out, err = None, e
            else:
                err = None
            self.busy = False
            if callback:
                callback(out, err)
        self.busy = True
        source = f"{JS_LIB}\n((NU) => ({script}))(__nuvpn)"
        self.view.evaluate_javascript(source, -1, None, None, None, done)

    def act(self, name, arg=None):
        self.trace(f"  -> {name}")
        script = JS_ACTIONS[name].replace("ARG", json.dumps(arg if arg is not None else ""))
        self.js(script, lambda out, err: out != "ok" and self.trace(f"action {name} -> {out or err}"))

    def prompt(self, kind, text, callback):
        """Ask via kdialog without blocking the page; callback(value or None)."""
        Gio = self.Gio
        self.busy = True
        proc = Gio.Subprocess.new(kdialog_argv(kind, text), Gio.SubprocessFlags.STDOUT_PIPE)
        self.prompt_proc = proc

        def done(p, res):
            try:
                _, out, _ = p.communicate_utf8_finish(res)
            except Exception:
                out = None
            self.prompt_proc = None
            if self.result is not None or self.error is not None:
                return
            self.busy = False
            callback(out.rstrip("\n") if p.get_successful() and out is not None else None)
        proc.communicate_utf8_async(None, None, done)

    def show(self, why, st=None):
        if self.shown:
            return
        if not self.interactive:
            self.stop(error=Abort(f"sign-in needs you ({why})", EXIT_NEEDS_USER))
            return
        self.trace(f"showing the browser window: {why}")
        self.shown = True
        self.shown_at = (st or {}).get("host"), (st or {}).get("path"), (st or {}).get("state")
        self.win.set_title(f"{TITLE}: please finish signing in")
        self.win.present()

    # -- signals ---------------------------------------------------------

    def on_close(self, *_):
        self.stop(error=Abort("sign-in window closed", EXIT_CANCELED))
        return True

    def on_signal(self):
        self.stop(error=Abort("cancelled", EXIT_CANCELED))
        return False

    def on_timeout(self):
        self.stop(error=Abort("sign-in timed out"))
        return False

    def on_load_failed(self, view, event, uri, err):
        # Cancelled loads (redirect chains) are normal.
        if not err.matches(self.WebKit.network_error_quark(), self.WebKit.NetworkError.CANCELLED):
            self.trace(f"load failed: {urllib.parse.urlsplit(uri or '').hostname}: {err.message}")
        return False

    def on_load_changed(self, view, event):
        if event != self.WebKit.LoadEvent.FINISHED:
            return
        uri = view.get_uri() or ""
        host = urllib.parse.urlsplit(uri).hostname
        resource = view.get_main_resource()
        response = resource.get_response() if resource else None
        headers = response.get_http_headers() if response else None
        found = {}
        if headers is not None:
            for k in ("saml-auth-status", "saml-username", "prelogin-cookie", "portal-userauthcookie"):
                v = headers.get_one(k)
                if v:
                    found[k] = v
        if self.check_done(found):
            return
        if host == self.vpn.host and resource is not None:
            # Some PAN-OS versions put the values in an HTML comment instead.
            resource.get_data(None, self.on_portal_body)

    def on_portal_body(self, resource, res):
        try:
            data = resource.get_data_finish(res)
        except Exception:
            return
        body = bytes(data).decode("utf-8", "replace")
        found = dict(re.findall(
            r"<(saml-auth-status|saml-username|prelogin-cookie|portal-userauthcookie)>([^<]*)</\1>", body))
        if not self.check_done({k: v for k, v in found.items() if v}):
            if found.get("saml-auth-status") == "-1":
                self.stop(error=Abort("the VPN portal rejected the sign-in"))

    def check_done(self, found):
        if found.get("saml-username") and (found.get("prelogin-cookie") or found.get("portal-userauthcookie")):
            self.trace(f"portal accepted SAML sign-in for {found['saml-username']}")
            self.stop(result=found)
            return True
        return False

    # -- the state machine -----------------------------------------------

    def size_hidden_view(self):
        # A never-shown view gets a 0x0 viewport, which squashes page layout.
        if not self.shown:
            self.view.allocate(520, 720, -1, None)

    def tick(self):
        if self.result is not None or self.error is not None:
            return False
        self.size_hidden_view()
        if not self.busy:
            self.js(JS_CLASSIFY, self.on_classified)
        return True

    def on_classified(self, out, err):
        if out is None:
            return
        try:
            st = json.loads(out)
        except ValueError:
            return
        now = time.monotonic()
        state = st.get("state")
        key = (st.get("host"), st.get("path"), state, st.get("error"))
        if key != self.last_key:
            self.last_key, self.last_change = key, now
            desc = f"page {st.get('host')}{st.get('path')} state={state or '?'}"
            if st.get("error"):
                desc += f" error={st['error']!r}"
            desc += f" heading={st.get('heading')!r}"
            if not state:
                desc += f" buttons={st.get('buttons')}"
            self.trace(desc)

        if self.probe and state:
            self.stop(result={"probe": st})
            return
        if not state:
            if now - self.last_change > STUCK_AFTER:
                self.show(f"unrecognised page on {st.get('host')}", st)
            return
        if state == "ms-error":
            self.stop(error=Abort(f"Microsoft sign-in error: {st.get('error')}"))
            return
        if self.shown:
            if (st.get("host"), st.get("path"), state) == self.shown_at:
                return            # still on the page you're finishing by hand
            self.trace("back on familiar pages; hiding the window again")
            self.shown = False
            self.win.set_visible(False)
            self.size_hidden_view()
        if state in SETTLE_STATES and st.get("age", SETTLE_MS) < SETTLE_MS:
            return

        handler = getattr(self, "on_" + state.replace("-", "_"))
        handler(st, now)

    def tried(self, st, now, wait=4.0):
        """Rate-limit an action per page/state; False if we should wait."""
        k = (st.get("host"), st.get("path"), st.get("state"))
        count, last = self.acted.get(k, (0, 0.0))
        if now - last < wait:
            return False
        if count >= MAX_TRIES:
            self.show(f"stuck at {st.get('state')} on {st.get('host')}", st)
            return False
        self.acted[k] = (count + 1, now)
        return True

    def on_username(self, st, now):
        if self.user_submitted and st.get("errorField") == "username":
            self.stop(error=Abort(f"Microsoft doesn't accept the username {self.username!r}: "
                                  f"{st.get('error')}  (fix it with: {APP} setup)"))
            return
        if self.tried(st, now):
            self.user_submitted = True
            self.act("username", self.username)

    def on_picker(self, st, now):
        if self.tried(st, now):
            self.act("picker", self.username)

    def on_password(self, st, now):
        # Wait for Microsoft to answer before believing an error on the page.
        if now - self.pw_sent_at < 5:
            return
        if self.pw_submitted and st.get("errorField") == "password":
            if not self.interactive:
                self.stop(error=Abort("Microsoft rejected the saved password", EXIT_NEEDS_USER))
                return
            self.pw_submitted = False
            self.acted.pop((st.get("host"), st.get("path"), "password"), None)

            def got(pw):
                if pw is None:
                    self.stop(error=Abort("cancelled", EXIT_CANCELED))
                    return
                store_password(self.username, pw)
                self.trace("saved the new password in the keyring")
                self.pw_submitted = True
                self.pw_sent_at = time.monotonic()
                self.act("password", {"user": self.username, "pw": pw})
            self.prompt("password", f"Microsoft didn't accept the saved password for {self.username}.\n"
                                    f"Current password:", got)
            return
        if not self.tried(st, now, wait=6.0):
            return
        pw = get_password(self.username)
        if not pw:
            self.stop(error=Abort(f"no password saved for {self.username}; run: {APP} setup"))
            return
        self.pw_submitted = True
        self.pw_sent_at = time.monotonic()
        self.act("password", {"user": self.username, "pw": pw})

    def on_kmsi(self, st, now):
        if self.tried(st, now):
            self.act("kmsi")

    def on_proofs(self, st, now):
        if self.tried(st, now):
            self.act("proofs")

    def on_continue(self, st, now):
        if self.tried(st, now):
            self.act("continue")

    def push_mode(self):
        return self.duo == "push" and not self.no_push

    def on_other_options(self, st, now):
        if self.push_mode():
            self.wait_for_push(st, now)
        elif self.tried(st, now, wait=3.0):
            self.act("other-options")

    def wait_for_push(self, st, now):
        """On Duo's push screen: tell you, then wait for your phone."""
        if self.push_denied(st):
            return
        if not self.interactive:
            self.stop(error=Abort("Duo wants a push approved", EXIT_NEEDS_USER))
            return
        code = st.get("pushCode")
        if not code and not self.push_notice:
            # Duo draws the number a moment after the screen; don't announce a
            # plain push and then change our mind.
            self.push_seen_at = self.push_seen_at or now
            if now - self.push_seen_at < 2.0:
                return
        if not self.push_notice or code != self.push_notice_code:
            if code:
                summary, text = f"Duo code: {code}", f"Enter {code} in Duo Mobile to approve the VPN sign-in."
            else:
                summary, text = TITLE, "Approve the Duo push on your phone."
            self.trace("waiting for you to approve the Duo push" + (f" (code {code})" if code else ""))
            self.push_notice = notify(text, max(self.push_notice, 0), timeout_ms=0,
                                      summary=summary, urgent=True) or -1
            self.push_notice_code = code

    def push_denied(self, st):
        """You tapped Deny on the phone: that's a cancel, not a reason to push again."""
        said = f"{st.get('error') or ''} {st.get('heading') or ''}"
        if re.search(r"denied|declined|fraud", said, re.I):
            self.stop(error=Abort(f"Duo push denied ({said.strip()})", EXIT_CANCELED))
            return True
        return False

    def on_push_send(self, st, now):
        if not self.push_mode():
            if self.tried(st, now, wait=3.0):
                self.act("other-options")
            return
        if self.push_denied(st):
            return
        if self.push_sends >= MAX_PUSHES:
            self.stop(error=Abort("the Duo push wasn't approved", EXIT_CANCELED))
            return
        if self.tried(st, now, wait=3.0):
            self.push_sends += 1
            self.act("push-send")

    def on_methods(self, st, now):
        if self.duo == "push" and not any(m.lower().startswith("duo push") for m in st.get("methods", [])):
            self.trace("Duo offers no push here; using the Duo Mobile passcode")
            self.no_push = True
        if self.tried(st, now, wait=3.0):
            self.act("method-push" if self.push_mode() else "methods")

    def on_trust(self, st, now):
        if self.tried(st, now):
            self.act("trust")

    def on_passcode(self, st, now):
        if self.push_mode() and not self.shown:
            # Duo opened on the passcode screen (the last method used); go to the push.
            if self.tried(st, now, wait=3.0):
                self.act("other-options")
            return
        if self.code_sent_at is not None:
            since = now - self.code_sent_at
            # Give Duo time to check the code before asking again.
            if since < 3 or (not st.get("error") and since < 15):
                return
        if not self.interactive:
            self.stop(error=Abort("Duo wants a passcode", EXIT_NEEDS_USER))
            return
        if self.code_prompts >= MAX_TRIES:
            self.show("Duo didn't accept the passcode", st)
            return
        self.code_prompts += 1
        self.trace("asking you for the Duo Mobile passcode")
        text = "Duo Mobile passcode:"
        if self.code_sent_at is not None and st.get("error"):
            text = f"Duo said: {st['error']}\n\n{text}"

        def got(code):
            if code is None:
                self.stop(error=Abort("cancelled", EXIT_CANCELED))
                return
            self.code_sent_at = time.monotonic()
            self.act("passcode", re.sub(r"\s+", "", code))
        self.prompt("code", text, got)


