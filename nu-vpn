def cmd_connect(args, cfg):
    import dbus
    uuid = args.uuid or (config_uuids(cfg) or [None])[0]
    if not uuid:
        raise Abort(f"no VPN connection configured; run: {APP} setup")
    NM = "org.freedesktop.NetworkManager"
    bus = dbus.SystemBus()
    settings = dbus.Interface(bus.get_object(NM, "/org/freedesktop/NetworkManager/Settings"),
                              NM + ".Settings")
    path = settings.GetConnectionByUuid(uuid)
    # Not `nmcli connection up`: nmcli answers its own secrets request with
    # "cancelled". Activating from a process with no secret agent makes
    # NetworkManager ask the agents in their usual order, like Plasma's applet.
    nm = dbus.Interface(bus.get_object(NM, "/org/freedesktop/NetworkManager"), NM)
    active = nm.ActivateConnection(path, dbus.ObjectPath("/"), dbus.ObjectPath("/"))
    props = dbus.Interface(bus.get_object(NM, active), "org.freedesktop.DBus.Properties")
    print("connecting...", flush=True)
    deadline = time.monotonic() + LOGIN_TIMEOUT + 60
    while time.monotonic() < deadline:
        try:
            state = int(props.Get(NM + ".Connection.Active", "State"))
        except dbus.DBusException:
            state = 4                                    # object gone: it failed
        if state == 2:
            print("connected")
            return
        if state >= 3:
            raise Abort("the VPN connection failed (see: journalctl --user -u nu-vpn-agent)")
        time.sleep(0.5)
    raise Abort("gave up waiting for the VPN to connect")


