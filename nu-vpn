def cmd_agent(args, cfg):
    import dbus
    import dbus.service
    import dbus.mainloop.glib
    from gi.repository import Gio, GLib

    NM = "org.freedesktop.NetworkManager"
    AGENT_IFACE = NM + ".SecretAgent"
    ERR = NM + ".SecretAgent."
    uuids = set(config_uuids(cfg))
    if not uuids:
        raise Abort(f"no VPN connection configured; run: {APP} setup")

    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SystemBus()
    loop = GLib.MainLoop()

    class AgentError(dbus.DBusException):
        def __init__(self, name, msg):
            super().__init__(msg, name=ERR + name)

    class Agent(dbus.service.Object):
        def __init__(self):
            super().__init__(bus, "/org/freedesktop/NetworkManager/SecretAgent")
            self.pending = {}   # (connection path, setting name) -> (process, error callback)
            self.failed_at = {}  # uuid -> when our last sign-in failed
            self.canceled_at = {}  # uuid -> when you last cancelled

        @dbus.service.method(AGENT_IFACE, in_signature="a{sa{sv}}osasu", out_signature="a{sa{sv}}",
                             async_callbacks=("reply", "error"))
        def GetSecrets(self, connection, path, setting_name, hints, flags, reply, error):
            con = connection.get("connection", {})
            uuid = str(con.get("uuid", ""))
            if setting_name != "vpn" or uuid not in uuids:
                error(AgentError("NoSecrets", "not a connection nu-vpn handles"))
                return
            key = (str(path), str(setting_name))
            if key in self.pending:
                error(AgentError("NoSecrets", "a sign-in is already running"))
                return
            # NetworkManager first asks with only USER_REQUESTED (0x4), then again
            # with ALLOW_INTERACTION (0x1). Plasma only shows its window in the
            # second round, so when you clicked Connect we can ask for the Duo
            # code straight away. Without either flag (autoconnect), stay silent.
            interactive = bool(flags & 0x5)
            # Cancelling in the first round doesn't stop NetworkManager; it asks
            # again straight away. Make the cancel stick.
            if time.monotonic() - self.canceled_at.pop(uuid, -1e9) < 15:
                log("you just cancelled; cancelling this round too")
                error(AgentError("UserCanceled", "cancelled"))
                return
            if time.monotonic() - self.failed_at.get(uuid, -1e9) < 60:
                log("our sign-in just failed; leaving this round to Plasma's dialog")
                self.failed_at.pop(uuid)
                error(AgentError("NoSecrets", "nu-vpn sign-in failed"))
                return
            log(f"secrets requested for {con.get('id', uuid)} (flags {int(flags):#x})")
            argv = [sys.executable, str(SCRIPT), "login", "--json", "--uuid", uuid,
                    "--timeout", str(LOGIN_TIMEOUT)]
            if not interactive:
                argv.append("--no-interaction")
            proc = Gio.Subprocess.new(argv, Gio.SubprocessFlags.STDOUT_PIPE)
            self.pending[key] = (proc, error)

            def done(p, res):
                try:
                    _, out, _ = p.communicate_utf8_finish(res)
                except Exception:
                    out = ""
                if self.pending.pop(key, None) is None:
                    return        # already cancelled and answered
                status = p.get_exit_status() if p.get_if_exited() else -1
                if status == 0:
                    try:
                        secrets = json.loads(out)
                    except ValueError:
                        error(AgentError("NoSecrets", "sign-in helper returned garbage"))
                        return
                    log("sign-in done; handing the cookie to NetworkManager")
                    reply({"vpn": {"secrets": dbus.Dictionary(secrets, signature="ss")}})
                elif status == EXIT_CANCELED:
                    log("sign-in cancelled")
                    self.canceled_at[uuid] = time.monotonic()
                    error(AgentError("UserCanceled", "cancelled"))
                elif status == EXIT_NEEDS_USER:
                    log("sign-in needs you; waiting for NetworkManager's interactive round")
                    error(AgentError("NoSecrets", "nu-vpn needs interaction"))
                else:
                    log(f"sign-in failed (exit {status}); Plasma's dialog gets the next try")
                    self.failed_at[uuid] = time.monotonic()
                    error(AgentError("NoSecrets", "nu-vpn sign-in failed"))
            proc.communicate_utf8_async(None, None, done)

        @dbus.service.method(AGENT_IFACE, in_signature="os", out_signature="")
        def CancelGetSecrets(self, path, setting_name):
            entry = self.pending.pop((str(path), str(setting_name)), None)
            if entry:
                proc, error = entry
                log("NetworkManager cancelled the request")
                proc.send_signal(15)
                error(AgentError("AgentCanceled", "cancelled by NetworkManager"))

        @dbus.service.method(AGENT_IFACE, in_signature="a{sa{sv}}o", out_signature="")
        def SaveSecrets(self, connection, path):
            pass          # nothing to keep: the cookie is single-use

        @dbus.service.method(AGENT_IFACE, in_signature="a{sa{sv}}o", out_signature="")
        def DeleteSecrets(self, connection, path):
            pass

    agent = Agent()

    def register(owner):
        if not owner:
            log("NetworkManager went away; waiting")
            return
        try:
            mgr = dbus.Interface(bus.get_object(NM, "/org/freedesktop/NetworkManager/AgentManager"),
                                 NM + ".AgentManager")
            mgr.RegisterWithCapabilities("edu.northeastern.nu-vpn", dbus.UInt32(0x1))   # VPN_HINTS
            log(f"registered with NetworkManager for {', '.join(sorted(uuids))}")
        except dbus.DBusException as e:
            log(f"could not register with NetworkManager: {e}")
    bus.watch_name_owner(NM, register)

    # NetworkManager asks the most recently *started* agent first. If Plasma's
    # kded restarts after us, exit so systemd restarts us and we're newest again.
    def start_time(pid):
        try:
            stat = Path(f"/proc/{pid}/stat").read_text()
            return int(stat.rsplit(")", 1)[1].split()[19])
        except (OSError, ValueError, IndexError):
            return 0
    mine = start_time(os.getpid())

    def check_rivals():
        if agent.pending:
            return True
        for p in Path("/proc").iterdir():
            if not p.name.isdigit():
                continue
            try:
                if p.stat().st_uid != os.getuid() or (p / "comm").read_text().strip() not in ("kded6", "kded5"):
                    continue
            except OSError:
                continue
            if start_time(p.name) > mine:
                log("Plasma's agent restarted after us; restarting to stay first in line")
                loop.quit()
                return False
        return True
    GLib.timeout_add_seconds(30, check_rivals)

    loop.run()


# ----------------------------------------------------------------- main ----

def main():
    ap = argparse.ArgumentParser(prog=APP, description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("setup", help="save username and password")
    p.add_argument("--username")
    p.add_argument("--uuid", help="NetworkManager connection UUID to handle")
    p.add_argument("--gateway", help="GlobalProtect gateway to choose from the portal list")
    p.add_argument("--keep-password", action="store_true", help="don't ask again if one is saved")
    p.set_defaults(func=cmd_setup)

    p = sub.add_parser("login", help="run the sign-in once (debugging)")
    p.add_argument("--uuid")
    p.add_argument("--json", action="store_true", help="print the secrets as JSON (used by the agent)")
    p.add_argument("--no-interaction", action="store_true")
    p.add_argument("--timeout", type=int, default=LOGIN_TIMEOUT)
    p.add_argument("--probe", action="store_true",
                   help="stop at the first recognised sign-in page and describe it; submits nothing")
    p.set_defaults(func=cmd_login)

    p = sub.add_parser("agent", help="run the NetworkManager secret agent")
    p.set_defaults(func=cmd_agent)

    p = sub.add_parser("connect", help="bring the VPN up")
    p.add_argument("--uuid")
    p.set_defaults(func=cmd_connect)

    p = sub.add_parser("forget", help="clear the remembered Microsoft/Duo session")
    p.set_defaults(func=cmd_forget)

    args = ap.parse_args()
    try:
        args.func(args, load_config())
    except Abort as e:
        log(str(e))
        if args.cmd == "login" and e.code not in (EXIT_CANCELED, EXIT_NEEDS_USER):
            notify(f"VPN sign-in failed: {e}")
        sys.exit(e.code)
    except KeyboardInterrupt:
        sys.exit(EXIT_CANCELED)


if __name__ == "__main__":
    main()
